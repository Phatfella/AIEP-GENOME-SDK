{
    "name": "@aiep/verify",
    "version": "1.0.0",
    "description": "AIEP GENOME conformance verifier — TypeScript kernel + AIEP-VECTORS runner",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "self-test": "tsx src/cli.ts --self-test",
        "verify": "tsx src/cli.ts --vectors ../../AIEP-VECTORS/v1.1.0/",
        "verify:malformed": "tsx src/cli.ts --vectors ../../AIEP-VECTORS/v1.0.0-malformed/",
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^20.19.39",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "license": "Apache-2.0"
}
